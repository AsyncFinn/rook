-- PlaybackState and Completed through a tween's life, and what a newer
-- tween on the same property does to the older one.
local TweenService = game:GetService("TweenService")
local p = Instance.new("Part")
local a = TweenService:Create(p, TweenInfo.new(0.3), { Transparency = 1 })
a.Completed:Connect(function(state) log("a.Completed", state) end)
log("a before", a.PlaybackState)
a:Play()
log("a playing", a.PlaybackState)
a:Pause()
log("a paused", a.PlaybackState)
a:Play()
local b = TweenService:Create(p, TweenInfo.new(0.3), { Transparency = 0.5 })
b.Completed:Connect(function(state) log("b.Completed", state) end)
b:Play()
task.wait()
log("a after b", a.PlaybackState, "b", b.PlaybackState)
task.wait(0.5)
log("end", a.PlaybackState, b.PlaybackState, p.Transparency)
local c = TweenService:Create(p, TweenInfo.new(1), { Transparency = 0 })
c.Completed:Connect(function(state) log("c.Completed", state) end)
c:Play()
c:Cancel()
task.wait()
log("cancelled", c.PlaybackState, p.Transparency)
p:Destroy()
