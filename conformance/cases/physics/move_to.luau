-- Model:MoveTo: where a model ends up over what's in its way. Parts go far
-- above the place and are destroyed at the end.
local BLOCK = Vector3.new(4, 2, 4)
local Y = 1000
local made = {}
local function part(parent, x, y, size, props)
    local p = Instance.new("Part")
    p.Anchored = true
    p.Size = size or Vector3.new(2, 2, 2)
    p.CFrame = CFrame.new(x, Y + y, 0)
    for k, v in pairs(props or {}) do
        p[k] = v
    end
    p.Parent = parent
    table.insert(made, p)
    return p
end
local function model(parent)
    local m = Instance.new("Model")
    m.Parent = parent or workspace
    table.insert(made, m)
    return m
end
local function single(props, size)
    local m = model()
    m.PrimaryPart = part(m, 0, 50, size, props)
    return m
end
local function at(m)
    local c = m:GetPivot().Position
    return string.format("%.3f,%.3f,%.3f", c.X, c.Y - Y, c.Z)
end
local function case(name, f)
    log(name, f())
    for _, p in ipairs(made) do
        p:Destroy()
    end
    table.clear(made)
end
local goal = Vector3.new(0, Y, 0)

case("free space", function()
    local m = single()
    m:MoveTo(goal)
    return at(m)
end)
case("onto a block", function()
    part(workspace, 0, 0, BLOCK)
    local m = single()
    m:MoveTo(goal)
    return at(m)
end)
case("a ball over a block", function()
    part(workspace, 0, 0, BLOCK)
    local m = single({ Shape = Enum.PartType.Ball })
    m:MoveTo(goal)
    return at(m)
end)
case("a ball off the edge", function()
    part(workspace, 0, 0, BLOCK)
    local m = single({ Shape = Enum.PartType.Ball })
    m:MoveTo(goal + Vector3.new(2.5, 0, 0))
    return at(m)
end)
case("a turned cube", function()
    part(workspace, 0, 0, BLOCK)
    local m = single()
    m.PrimaryPart.CFrame = m.PrimaryPart.CFrame * CFrame.Angles(0, 0, math.pi / 4)
    m:MoveTo(goal)
    return at(m)
end)
case("a wedge", function()
    part(workspace, 0, 0, BLOCK)
    local m = model()
    local w = Instance.new("WedgePart")
    w.Anchored = true
    w.Size = Vector3.new(2, 2, 2)
    w.CFrame = CFrame.new(0, Y + 50, 0)
    w.Parent = m
    m.PrimaryPart = w
    m:MoveTo(goal)
    return at(m)
end)
case("CanCollide false in the way", function()
    part(workspace, 0, 0, BLOCK, { CanCollide = false })
    local m = single()
    m:MoveTo(goal)
    return at(m)
end)
case("CanTouch false in the way", function()
    part(workspace, 0, 0, BLOCK, { CanTouch = false })
    local m = single()
    m:MoveTo(goal)
    return at(m)
end)
case("a gap too small is passed", function()
    part(workspace, 0, 0, BLOCK)
    part(workspace, 0, 4, BLOCK)
    local m = single()
    m:MoveTo(goal)
    return at(m)
end)
case("a gap barely too small is passed", function()
    part(workspace, 0, 0, BLOCK)
    part(workspace, 0, 4.01, BLOCK)
    local m = single()
    m:MoveTo(goal)
    return at(m)
end)
case("a gap barely large enough stops it", function()
    part(workspace, 0, 0, BLOCK)
    part(workspace, 0, 4.03, BLOCK)
    local m = single()
    m:MoveTo(goal)
    return at(m)
end)
case("a gap large enough stops it", function()
    part(workspace, 0, 0, BLOCK)
    part(workspace, 0, 8, BLOCK)
    local m = single()
    m:MoveTo(goal)
    return at(m)
end)
case("touching doesn't lift", function()
    part(workspace, 0, 0, BLOCK)
    local m = single()
    m:MoveTo(goal + Vector3.new(0, 2, 0))
    return at(m)
end)
case("sinking a little lifts", function()
    part(workspace, 0, 0, BLOCK)
    local m = single()
    m:MoveTo(goal + Vector3.new(0, 1.999, 0))
    return at(m)
end)
case("touching at the side doesn't lift", function()
    part(workspace, 0, 0, BLOCK)
    local m = single()
    m:MoveTo(goal + Vector3.new(3, 0, 0))
    return at(m)
end)
case("its own CanCollide false parts don't count", function()
    part(workspace, 5, 0, BLOCK)
    local m = model()
    m.PrimaryPart = part(m, 0, 50)
    part(m, 5, 50, nil, { CanCollide = false })
    m:MoveTo(goal)
    return at(m)
end)
case("any part obstructed lifts them all", function()
    part(workspace, 5, 0, BLOCK)
    local m = model()
    m.PrimaryPart = part(m, 0, 50)
    part(m, 5, 50)
    m:MoveTo(goal)
    return at(m)
end)
case("no PrimaryPart: the bounding box center", function()
    local m = model()
    part(m, 0, 50)
    part(m, 6, 50)
    m:MoveTo(goal)
    local _, size = m:GetBoundingBox()
    return string.format("%.3f,%.3f", m:GetBoundingBox().Position.X, size.X)
end)
case("a turned model", function()
    part(workspace, 0, 0, BLOCK)
    local m = model()
    local spin = CFrame.Angles(0, 0, math.pi / 4)
    m.PrimaryPart = part(m, 0, 50, Vector3.new(6, 2, 2))
    m.PrimaryPart.CFrame = m.PrimaryPart.CFrame * spin
    m:MoveTo(goal)
    return at(m)
end)
case("a model outside Workspace stays", function()
    local m = model(game:GetService("Lighting"))
    m.PrimaryPart = part(m, 0, 50)
    m:MoveTo(goal)
    return at(m)
end)
case("a model with no parent stays", function()
    local m = model()
    m.PrimaryPart = part(m, 0, 50)
    m.Parent = nil
    m:MoveTo(goal)
    return at(m)
end)
case("an empty model", function()
    local m = model()
    return pcall(function()
        m:MoveTo(goal)
    end)
end)
